# -----------------------------------------------------------------------------
# Terraform Remote State Backend Configuration (Example)
# Enables team collaboration, S3 server-side encryption, and DynamoDB state locking
# -----------------------------------------------------------------------------
# To use this:
# 1. Create an S3 bucket (e.g., `my-company-terraform-state`) with versioning enabled
# 2. Create a DynamoDB table (e.g., `terraform-state-lock`) with partition key `LockID` (String)
# 3. Rename this file to `backend.tf` and run `terraform init`

# terraform {
#   backend "s3" {
#     bucket         = "ecommerce-terraform-state-bucket"
#     key            = "ecommerce/staging/terraform.tfstate"
#     region         = "us-east-1"
#     encrypt        = true
#     dynamodb_table = "ecommerce-terraform-locks"
#   }
# }
